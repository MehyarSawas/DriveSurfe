APP_URL=https://your-domain.com
APP_ENV=production

# Must be a strong random string (min 32 chars): openssl rand -hex 32
SESSION_KEY=change-this-to-a-random-32-char-string

# One-time token to register the first passkey device — keep this secret
REGISTRATION_TOKEN=change-this-to-a-random-secret-token

KDRIVE_DRIVE_ID=your_kdrive_drive_id
KDRIVE_TOKEN=your_kdrive_api_token

# Optional: restrict the Timeline (media stream + month index) to one folder
# (recursively) instead of the whole drive. Numeric kDrive folder ID.
#TIMELINE_FOLDER_ID=12345

# Optional: path to the ffmpeg binary, used to transcode videos the browser
# can't play natively (e.g. old MPEG-4 Visual) to H.264 on the fly. Defaults
# to whatever `ffmpeg` resolves to on PATH; set this only if it's elsewhere.
#FFMPEG_BIN=/usr/bin/ffmpeg

# Inbound email webhook (POST /api/hooks/gmail). Leave unset to disable the
# endpoint entirely (it then answers 404). Min 32 chars: openssl rand -hex 32
# The same value goes into the Google Apps Script (integrations/gmail-webhook.gs).
#MAIL_WEBHOOK_SECRET=
# Max accepted webhook body in MB (base64 attachments included). Default 40.
#MAIL_WEBHOOK_MAX_MB=40
# Timezone for {date:...} variables in mail processor paths (default: PHP's).
#APP_TIMEZONE=Europe/Zurich
